---
// src/components/ContentRenderer/variants/FeatureCardVariant.astro
/**
 * Feature Card Variant — the bordered icon-card grid the 2025 Monmouth County
 * landing pages used for "Why Choose Koi Roofing & Solar?" and the topic grids
 * ("Why Choose Solar Power?", "Roofing Solutions for Every Industry").
 *
 * Legacy markup, ported verbatim:
 *   • grid  — `grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg`
 *   • card  — `p-lg border border-[var(--color-border)] rounded-lg`
 *   • icon  — 12x12 `bg-primary rounded-full`, 6x6 stroked SVG in
 *             `text-accent`. The 2025 markup used a pale `bg-secondary/10`
 *             circle with a `text-secondary` glyph; that light blue isn't part
 *             of the brand palette in use, so icons site-wide are the primary
 *             navy circle with the gold glyph instead.
 *   • title — `.h5 text-primary font-bold` (the solar page used `.h4`)
 *   • body  — `text-text`
 *
 * Cards carry their icon as raw SVG path data (`svgPaths`) because the legacy
 * pages hand-wrote inline heroicons rather than using the icon registry —
 * keeping the exact paths is what makes these render identically. An item may
 * instead supply `icon` (an iconify token) to use the shared Icon component.
 */
import type { BaseVariantProps } from "../ContentRenderer.types";
import SectionHeading from "@/components/SectionHeading.astro";
import SectionButtons from "../SectionButtons.astro";
import Icon from "@/components/Icon";

interface Props extends BaseVariantProps {
  pretitle?: string;
  columns?: 1 | 2 | 3 | 4;
  /** `h5` matches most pages; the solar page used the slightly larger `h4`. */
  titleSize?: "h4" | "h5";
  /** Legacy pages centered these cards except on the solar page. */
  centered?: boolean;
}

const {
  items = [],
  title,
  heading,
  pretitle,
  description,
  className = "",
  buttons = [],
  buttonsClassName = "",
  columns = 3,
  titleSize = "h5",
  centered = true,
  id,
} = Astro.props as Props;

const columnClasses: Record<number, string> = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
};

const cards = Array.isArray(items) ? items : [];
---

<section id={id} class={`bg-bg text-text py-[var(--spacing-3xl)] ${className}`}>
  <div class="container mx-auto px-4">
    {(heading || title || pretitle || description) && (
      <SectionHeading
        pretitle={pretitle}
        heading={heading}
        title={title}
        description={description}
        class="pb-[var(--spacing-xl)]"
      />
    )}

    {cards.length > 0 && (
      <div class={`grid ${columnClasses[columns]} gap-[var(--spacing-lg)]`}>
        {cards.map((card: any) => (
          <div
            class:list={[
              "p-[var(--spacing-lg)] border border-[var(--color-border)] rounded-lg",
              centered && "text-center",
            ]}
          >
            {(card.svgPaths?.length || card.icon) && (
              <div
                class:list={[
                  "w-12 h-12 bg-primary rounded-full flex items-center justify-center mb-[var(--spacing-md)]",
                  centered && "mx-auto",
                ]}
              >
                {card.svgPaths?.length ? (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6 text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    {card.svgPaths.map((d: string) => (
                      <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                    ))}
                  </svg>
                ) : (
                  <Icon icon={card.icon} size="md" className="text-accent" />
                )}
              </div>
            )}

            {card.title && (
              <h3 class={`${titleSize} text-primary font-bold mb-[var(--spacing-sm)]`}>
                {card.title}
              </h3>
            )}
            {card.description && <p class="text-text">{card.description}</p>}
          </div>
        ))}
      </div>
    )}

    <SectionButtons buttons={buttons} class={`mt-[var(--spacing-xl)] ${buttonsClassName}`} />
  </div>
</section>
