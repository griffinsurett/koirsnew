---
// src/components/ContentRenderer/variants/ImageCardVariant.astro
/**
 * Image Card Variant — image-forward card grid (centered text under a large
 * rounded image). Driven by a collection query. Used for the additional
 * services (decking, siding) section.
 */
import type { BaseVariantProps } from "../ContentRenderer.types";
import ImageCard from "@/components/LoopComponents/ImageCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props extends BaseVariantProps {
  pretitle?: string;
  /** Red accent phrase appended after the title (matches the site's heading style). */
  accentTitle?: string;
  columns?: 1 | 2 | 3 | 4;
}

const {
  items = [],
  title,
  heading,
  accentTitle,
  description,
  pretitle,
  className = "",
  columns = 3,
  id,
} = Astro.props as Props;

const columnClasses = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
};

// Never render more columns than cards. This keeps a two-card collection at
// two columns while allowing four or more cards to use the requested four-
// column desktop grid.
const itemCount = Array.isArray(items) ? items.length : 0;
const effectiveColumns = Math.min(columns, Math.max(itemCount, 1)) as 1 | 2 | 3 | 4;
const isTwoCardLayout = itemCount === 2;
const gridClasses = isTwoCardLayout
  ? "max-w-[1400px] mx-auto gap-10 lg:gap-20"
  : "gap-8";
---

<section id={id} class={`bg-bg py-[100px] ${className}`}>
  <div class="container">
    <SectionHeading heading={heading}
      pretitle={pretitle}
      title={title}
      accentTitle={accentTitle}
      class="pb-[var(--spacing-2xl)]"
    />

    {
      items.length > 0 && (
        <div class={`grid ${columnClasses[effectiveColumns]} ${gridClasses}`}>
          {/* Multi-column cards stagger; a single column reveals together. */}
          {items.map((item, index) => (
            <ImageCard {...item} compact={isTwoCardLayout} animateDelay={effectiveColumns === 1 ? 0 : index * 120} />
          ))}
        </div>
      )
    }
  </div>
</section>
