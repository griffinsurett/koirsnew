---
// src/components/ContentRenderer/variants/TestimonialVariant.astro
/**
 * Testimonial Variant — a responsive grid of review cards, driven by the
 * testimonials collection. Emits schema.org Review + AggregateRating from the
 * reviews shown (schema follows visible content), attached to the site-wide
 * business entity.
 */
import type { BaseVariantProps } from "../ContentRenderer.types";
import TestimonialCard from "@/components/LoopComponents/TestimonialCard.astro";
import JsonLd from "@/components/JsonLd.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { buildReviewSchema } from "@/utils/schema/reviewSchema";

interface Props extends BaseVariantProps {
  columns?: 1 | 2 | 3;
}

const {
  items = [],
  title,
  heading,
  description,
  className = "",
  columns = 3,
  id,
} = Astro.props as Props;

const safeItems = Array.isArray(items) ? items : [];
const reviewSchema = buildReviewSchema(safeItems as any);

const columnClasses = {
  1: "grid-cols-1 max-w-2xl mx-auto",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
};
---
<JsonLd schema={reviewSchema} />

<section id={id} class={`py-16 ${className}`}>
  <div class="container mx-auto px-4">
    <SectionHeading heading={heading} title={title} description={description} />

    {safeItems.length > 0 && (
      <ul class={`grid gap-6 list-none ${columnClasses[columns]}`}>
        {safeItems.map((item: any) => (
          <li>
            {/* Static grid, so cards can safely pop in on scroll (unlike the
                marquee variants, whose tracks translate horizontally). */}
            <TestimonialCard {...item} animate={true} />
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
