---
// src/components/ContentRenderer/variants/ImageBoxVariant.astro
/**
 * Image Box Variant — the "Types of {line} We Offer" band from the 2025 site:
 * full-width rows stacked vertically, each a large image on one half and
 * centered title + copy on the other, with the sides alternating row to row.
 *
 * Ported from the legacy `listOfBoxes` variant + `ImageBox.astro`. Legacy
 * values kept verbatim:
 *   • band   — light bg, `section-md` rhythm, centered container
 *   • rows   — `flex flex-col gap-[var(--spacing-xl)]` (one per row)
 *   • row    — `lg:h-[50vh]`, rounded, shadow → shadow-lg on hover
 *   • halves — image `lg:w-1/2`, text `lg:w-1/2`, alternating via odd/even
 *   • title  — `.h3`, centered on desktop / left on mobile
 *   • copy   — `lg:text-lg text-text font-thin`
 *   • image  — `object-cover`, scales to 105% on row hover
 *
 * NOTE the legacy title class was `h3 text-bg` (near-white) because the card
 * sat on a dark band; here the band is light, so the title uses the heading
 * colour to stay legible. That's the one intentional deviation.
 */
import type { BaseVariantProps } from "../ContentRenderer.types";
import { Image } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import { resolveImageMetadata, getImageAlt } from "@/utils/images";

interface Props extends BaseVariantProps {
  /** Row height on desktop. Legacy used 50vh. */
  rowHeight?: string;
}

const {
  items = [],
  title,
  heading,
  pretitle,
  description,
  className = "",
  rowHeight = "lg:h-[50vh]",
  id,
} = Astro.props as Props;

const safeItems = Array.isArray(items) ? items : [];
---

<section
  id={id}
  class={`bg-bg w-full flex flex-col justify-center items-center py-[var(--spacing-2xl)] ${className}`}
>
  <div class="container mx-auto px-4 flex flex-col justify-center">
    <SectionHeading
      pretitle={pretitle}
      heading={heading}
      title={title}
      description={description}
      headingClass="uppercase py-[var(--spacing-sm)]"
    />

    {safeItems.length > 0 && (
      <ul class="list-none flex flex-col w-full gap-[var(--spacing-xl)]">
        {safeItems.map((item: any) => {
          const data = item.data ?? item;
          const media = resolveImageMetadata(data.featuredImage);
          const alt = getImageAlt(data.featuredImage, data.title ?? "");
          return (
            <li>
              {/* `group` drives both the hover shadow and the image zoom; the
                  odd/even rules flip which side the image sits on. */}
              <article
                class={`group w-full ${rowHeight} overflow-hidden shadow border-radius hover:shadow-lg transition-shadow`}
              >
                <div class="flex h-full flex-col lg:group-odd:flex-row lg:group-even:flex-row-reverse">
                  {media && (
                    <div class="w-full lg:w-1/2 h-full overflow-hidden">
                      <Image
                        src={media}
                        alt={alt}
                        format="webp"
                        loading="lazy"
                        fetchpriority="low"
                        quality="low"
                        class="h-full w-full object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
                      />
                    </div>
                  )}
                  <div class="w-full lg:w-1/2 p-[var(--spacing-md)] flex flex-col items-start lg:items-center text-left lg:text-center gap-[var(--spacing-sm)] lg:gap-0 justify-center">
                    <h3 class="h3 text-heading">{data.title}</h3>
                    {data.description && (
                      <p class="lg:text-lg text-text font-thin lg:px-[var(--spacing-xl)]">
                        {data.description}
                      </p>
                    )}
                  </div>
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>
