---
// src/components/LoopComponents/GridCard.astro
/**
 * Grid Card Component
 *
 * Simple card for grid layouts with:
 * - Optional icon (token, image asset, emoji or raw SVG)
 * - Optional image
 * - Title (linked or plain)
 * - Description
 * - Subtle hover effects
 *
 * Generic card used in GridVariant - the default section variant.
 *
 * `icon` is part of `baseSchema`, so every collection can supply one, and
 * `iconSchema` accepts an `image()` reference as well as a library token —
 * Koi's benefits band uses PNG/WebP artwork rather than line icons, and the
 * legacy site rendered it at 4rem on mobile / 150px up. This card previously
 * ignored the field entirely, so that artwork never reached the page.
 */
import Icon from "@/components/Icon";
import { Image } from "astro:assets";

export interface Props {
  title: string;
  url?: string;
  description?: string;
  icon?: any;
  image?: {
    src: string;
    alt: string;
  };
}

const { title, url, description, icon, image } = Astro.props;
---

<article
  data-animate="pop-in"
  data-animate-once="true"
  class="bg-bg rounded-lg overflow-hidden shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-200"
>
  {/* Optional image */}
  {
    image && (
      <img src={image.src} alt={image.alt} class="w-full h-48 object-cover" />
    )
  }

  {/* Card content */}
  <div class="p-6">
    {/* Icon above the title. alt/aria comes from the title so image icons
        aren't announced as unlabeled graphics.

        Image icons go through <Image>, not <Icon>. renderIcon() emits a plain
        <img src> at the icon-size map's pixel dimensions, which would ship the
        full-resolution source (insurance.png alone is 776 KB) and stamp a
        width/height that contradicts the CSS box. <Image> emits an optimized,
        correctly-sized, responsive WebP — matching what the legacy site served.
        Library tokens still route through <Icon>. */}
    {
      icon &&
        (typeof icon === "object" && "src" in icon ? (
          <div class="mb-4 flex justify-center">
            <Image
              src={icon}
              alt={title}
              width={200}
              height={200}
              densities={[1, 2]}
              sizes="(max-width: 640px) 4rem, 150px"
              class="w-16 h-16 md:w-[150px] md:h-[150px] object-contain"
              loading="lazy"
            />
          </div>
        ) : (
          <div class="mb-4 flex justify-center">
            <Icon
              icon={icon}
              size="xl"
              className="w-16 h-16 object-contain"
              aria-label={title}
            />
          </div>
        ))
    }
    <h3 class="text-xl font-semibold mb-2">
      {
        url ? (
          <a
            href={url}
            class="text-heading hover:text-primary transition-colors"
          >
            {title}
          </a>
        ) : (
          <span class="text-heading">{title}</span>
        )
      }
    </h3>

    {description && <p class="text-text leading-relaxed">{description}</p>}
  </div>
</article>
