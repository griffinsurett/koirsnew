---
// src/components/Form/forms/HiringForm.astro
/**
 * Apply to Join the Team — ported field-for-field from the legacy site.
 *
 * Falls back to the contact endpoint when PUBLIC_FORMSPREE_HIRING_ID is unset, matching the legacy
 * fallback chain.
 *
 * Includes the legacy resume upload. Formspree file uploads need a paid plan
 * (this account has one) and a multipart request — submitToFormspree switches
 * from JSON to multipart/form-data automatically when it sees a File, since a
 * File cannot survive JSON.stringify.
 */
import FormWrapper from "@/components/Form/FormWrapper";
import Input from "@/components/Form/inputs/Input";
import Textarea from "@/components/Form/inputs/Textarea";
import Checkbox from "@/components/Form/inputs/Checkbox";
import Button from "@/components/Button/Button";

interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const { title = "Apply to Join the KOI Team", description, className = "" } = Astro.props;

const formId =
  import.meta.env.PUBLIC_FORMSPREE_HIRING_ID ||
  import.meta.env.PUBLIC_FORMSPREE_CONTACT_ID ||
  import.meta.env.PUBLIC_FORMSPREE_ID;

const currentPageUrl = Astro.url.href;
---

{/* Legacy card wrapper, verbatim: cream panel, 2xl padding, rounded-4xl,
    shadow-lg, 90vw on mobile / full width from lg. The title is the legacy
    plain <label>, not an <h2>. */}
<div
  class={`bg-bg py-[var(--spacing-2xl)] px-[var(--spacing-2xl)] rounded-4xl shadow-lg w-[90vw] lg:w-full gap-[var(--spacing-md)] ${className}`}
>
  {title && (
    <label class="" for="hiring-form">
      {title}
    </label>
  )}
  {description && <p>{description}</p>}

  <FormWrapper
    client:idle
    formspreeId={formId}
    useNativeFormSubmission={Boolean(formId)}
    successMessage="Thanks for applying! We'll review your details and reach out."
    resetOnSuccess={true}
    className="pt-[var(--spacing-md)]"
  >
    <input type="hidden" name="formName" value="Koi Hiring Application" />
    <input type="hidden" name="pageUrl" value={currentPageUrl} />

    {/* Field layout ported from the legacy form: paired rows via
        `flex-col lg:flex-row lg:space-x-[var(--spacing-sm)]` with each field in
        an `lg:w-1/2`. Placeholders and which fields are required also match the
        legacy form — street/city/state/ZIP were optional there. */}
    <div class="flex flex-col lg:flex-row lg:space-x-[var(--spacing-sm)] text-sm">
      <div class="w-full lg:w-1/2">
        <Input name="firstName" label="First Name" placeholder="First Name" required={true} />
      </div>
      <div class="w-full lg:w-1/2">
        <Input name="lastName" label="Last Name" placeholder="Last Name" required={true} />
      </div>
    </div>

    <div class="flex flex-col lg:flex-row lg:space-x-[var(--spacing-sm)]">
      <div class="w-full lg:w-1/2">
        <Input name="email" type="email" label="Email Address" placeholder="you@example.com" required={true} />
      </div>
      <div class="w-full lg:w-1/2">
        <Input name="phone" type="tel" label="Phone Number" placeholder="123-456-7890" required={true} />
      </div>
    </div>

    <Input name="street" label="Street Address" placeholder="123 Main St" />

    <div class="flex flex-col lg:flex-row lg:space-x-[var(--spacing-sm)]">
      <div class="w-full lg:w-1/2">
        <Input name="city" label="City" placeholder="City" />
      </div>
      <div class="w-full lg:w-1/2">
        <Input name="state" label="State / Province" placeholder="State" />
      </div>
    </div>

    <Input name="postalCode" label="ZIP / Postal Code" placeholder="12345" />

    <Input
      name="positionInterest"
      label="Position of Interest"
      placeholder="e.g., Sales Rep, Roofer, Solar Installer"
      required={true}
    />

    {/* Resume upload — the legacy drag-and-drop dropzone, ported verbatim.
        The real <input type="file"> is sr-only and the styled .dropzone div is
        the visible target, so clicking the label or dropping a file both work.
        `name` matches the legacy field so existing Formspree rules keep
        working. */}
    <label
      for="hiring-resume"
      class="mb-[var(--spacing-md)] w-full flex flex-col text-left cursor-pointer"
      data-dropzone-wrapper
    >
      <span class="text-primary mb-[var(--spacing-xs)] font-thin text-left">
        Resume / CV
      </span>
      <input
        type="file"
        id="hiring-resume"
        name="resumeOrCv"
        accept=".pdf,.doc,.docx,.docm,.rtf"
        class="sr-only"
        required
        data-dropzone-input
      />
      <div class="dropzone" data-dropzone>
        <p class="text-primary font-medium">Drag &amp; drop your resume here</p>
        <p class="text-sm text-text">
          or <span class="text-secondary underline">browse</span> to upload
        </p>
        <p class="text-xs text-text" data-dropzone-filename aria-live="polite">
          Accepted formats: PDF, DOC, or DOCX (max 10MB)
        </p>
      </div>
    </label>

    <Textarea
      name="message"
      label="Tell us about yourself"
      placeholder="Share your experience, skills, and why you want to join the KOI team."
      rows={5}
      required={true}
    />

    {/* SMS/TCPA consent — legal requirement for texting applicants, separate
        from cookie consent (disabled site-wide). */}
    <Checkbox name="consent" required={true}>
      By checking this box, I consent to receive transactional messages related
      to my application. Message frequency may vary. Message &amp; Data rates may
      apply. Reply STOP to opt out.
    </Checkbox>

    <Button
      type="submit"
      variant="primary"
      className="w-full mt-[var(--spacing-sm)] justify-center cursor-pointer"
    >
      Submit
    </Button>
  </FormWrapper>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("[data-dropzone-wrapper]").forEach((wrapper) => {
      if (wrapper.dataset.dropzoneReady === "true") {
        return;
      }
      wrapper.dataset.dropzoneReady = "true";
      const input = wrapper.querySelector("[data-dropzone-input]");
      const zone = wrapper.querySelector("[data-dropzone]");
      const filename = wrapper.querySelector("[data-dropzone-filename]");
      if (!input || !zone) return;

      const defaultMessage = filename?.textContent || "";
      const updateFileName = () => {
        const file = input.files && input.files[0];
        if (filename) {
          filename.textContent = file
            ? `Selected file: ${file.name}`
            : defaultMessage;
        }
      };

      input.addEventListener("change", updateFileName);

      const preventDefaults = (event) => {
        event.preventDefault();
        event.stopPropagation();
      };

      ["dragenter", "dragover"].forEach((eventName) => {
        zone.addEventListener(eventName, (event) => {
          preventDefaults(event);
          zone.classList.add("is-dragging");
        });
      });

      ["dragleave", "dragend"].forEach((eventName) => {
        zone.addEventListener(eventName, (event) => {
          preventDefaults(event);
          zone.classList.remove("is-dragging");
        });
      });

      zone.addEventListener("drop", (event) => {
        preventDefaults(event);
        zone.classList.remove("is-dragging");
        const files = event.dataTransfer?.files;
        if (!files || !files.length) return;
        if (typeof DataTransfer !== "undefined") {
          const transfer = new DataTransfer();
          transfer.items.add(files[0]);
          input.files = transfer.files;
        } else {
          try {
            input.files = files;
          } catch {
            // Ignore assignment errors on older browsers.
          }
        }
        input.dispatchEvent(new Event("change", { bubbles: true }));
      });
    });
  });
</script>
