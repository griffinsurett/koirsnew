---
// src/components/Form/forms/InternshipForm.astro
/**
 * Apply for the Internship Program — ported field-for-field from the legacy site.
 *
 * Falls back to the contact endpoint when PUBLIC_FORMSPREE_INTERNSHIP_ID is unset, matching the legacy
 * fallback chain.
 *
 * NOTE: the legacy form included a resume file upload. Formspree file uploads
 * need a paid plan and a multipart submission path, so the field is omitted
 * here and applicants are asked to email their resume instead — flagged rather
 * than silently dropped.
 */
import FormWrapper from "@/components/Form/FormWrapper";
import Input from "@/components/Form/inputs/Input";
import Textarea from "@/components/Form/inputs/Textarea";
import Checkbox from "@/components/Form/inputs/Checkbox";
import Button from "@/components/Button/Button";

interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const { title = "Apply for the Internship Program", description, className = "" } = Astro.props;

const formId =
  import.meta.env.PUBLIC_FORMSPREE_INTERNSHIP_ID ||
  import.meta.env.PUBLIC_FORMSPREE_CONTACT_ID ||
  import.meta.env.PUBLIC_FORMSPREE_ID;

const currentPageUrl = Astro.url.href;
---

<div class={className}>
  {title && <h2>{title}</h2>}
  {description && <p>{description}</p>}

  <FormWrapper
    client:idle
    formspreeId={formId}
    useNativeFormSubmission={Boolean(formId)}
    successMessage="Thanks for applying! We'll be in touch about next steps."
    resetOnSuccess={true}
    className="w-full gap-0"
  >
    <input type="hidden" name="formName" value="Koi Internship Application" />
    <input type="hidden" name="pageUrl" value={currentPageUrl} />

    <Input name="firstName" label="First Name" type="text" required={true} />
    <Input name="lastName" label="Last Name" type="text" required={true} />
    <Input name="email" label="Email Address" type="email" required={true} />
    <Input name="phone" label="Phone Number" type="tel" required={true} />
    <Input name="street" label="Street Address" type="text" required={true} />
    <Input name="city" label="City" type="text" required={true} />
    <Input name="state" label="State / Province" type="text" required={true} />
    <Input name="zip" label="ZIP / Postal Code" type="text" required={true} />
    <Textarea name="message" label="Tell us why you're interested" rows={5} required={true} />

    {/* SMS/TCPA consent — legal requirement for texting applicants, separate
        from cookie consent (disabled site-wide). */}
    <Checkbox name="smsConsent" required={true}>
      By checking this box, I consent to receive transactional messages related
      to my application. Message frequency may vary. Message &amp; Data rates may
      apply. Reply STOP to opt out.
    </Checkbox>

    <Button type="submit" variant="primary">Submit</Button>
  </FormWrapper>
</div>
