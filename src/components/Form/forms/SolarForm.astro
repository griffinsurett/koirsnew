---
// src/components/Form/forms/SolarForm.astro
/**
 * Solar Inquiry Form — the conversion path on the solar pages.
 *
 * Ported field-for-field from the legacy site. Mirrors RoofingForm's shape but
 * qualifies on solar specifics (electric bill, roof age/shading, ownership)
 * rather than roof damage. The duplication is deliberate: the two lines of
 * business ask different questions and are free to diverge.
 */
import FormWrapper from "@/components/Form/FormWrapper";
import Input from "@/components/Form/inputs/Input";
import Select from "@/components/Form/inputs/Select";
import Textarea from "@/components/Form/inputs/Textarea";
import Checkbox from "@/components/Form/inputs/Checkbox";
import Button from "@/components/Button/Button";

interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const { title = "Solar Inquiry", description, className = "" } = Astro.props;

const formId =
  import.meta.env.PUBLIC_FORMSPREE_SOLAR_ID ||
  import.meta.env.PUBLIC_FORMSPREE_CONTACT_ID ||
  import.meta.env.PUBLIC_FORMSPREE_ID;

const currentPageUrl = Astro.url.href;

const yesNo = [
  { value: "", label: "Select an option" },
  { value: "yes", label: "Yes" },
  { value: "no", label: "No" },
];

const roofTypes = [
  { value: "", label: "Select roof type" },
  { value: "shingle", label: "Shingle" },
  { value: "flat", label: "Flat" },
  { value: "metal", label: "Metal" },
  { value: "tile", label: "Tile" },
  { value: "other", label: "Other" },
];
---

<div class={className}>
  {title && <h2 class="h4 text-primary text-center">{title}</h2>}
  {description && <p class="text-center text-text-light">{description}</p>}

  <FormWrapper
    client:idle
    formspreeId={formId}
    useNativeFormSubmission={Boolean(formId)}
    successMessage="Thanks! We'll be in touch about your solar consultation."
    resetOnSuccess={true}
    className="w-full gap-0"
  >
    <input type="hidden" name="formName" value="Koi Solar Inquiry" />
    <input type="hidden" name="pageUrl" value={currentPageUrl} />

    {/* Name pair and phone/email pair sit side by side from lg, matching the
        legacy form's two-column rows. */}
    <div class="flex flex-col lg:flex-row lg:space-x-[var(--spacing-sm)]">
      <div class="w-full lg:w-1/2">
        <Input name="firstName" placeholder="First Name" label="First Name" type="text" required={true} />
      </div>
      <div class="w-full lg:w-1/2">
        <Input name="lastName" placeholder="Last Name" label="Last Name" type="text" required={true} />
      </div>
    </div>

    <Input
      name="address"
      placeholder="123 Main St, City, ST 12345"
      label="Address (Include ZIP code)"
      type="text"
      required={true}
    />

    <div class="flex flex-col lg:flex-row lg:space-x-[var(--spacing-sm)]">
      <div class="w-full lg:w-1/2">
        <Input name="phone" placeholder="123-456-7890" label="Phone Number" type="tel" required={true} />
      </div>
      <div class="w-full lg:w-1/2">
        <Input name="email" placeholder="you@example.com" label="Email Address" type="email" required={true} />
      </div>
    </div>

    <Input
      name="monthlyBill"
      placeholder="e.g. $150"
      label="Approximately what is your average monthly electric bill?"
      type="text"
    />
    <Select
      name="roofType"
      placeholder="Select roof type"
      label="What type of roof do you have?"
      options={roofTypes}
      required={true}
    />
    <Input
      name="roofAge"
      placeholder="e.g. 10 years"
      label="Approximately How old is your roof? Take a guess if unsure"
      type="text"
    />
    <Select
      name="shading"
      placeholder="Select an option"
      label="Does your roof get significant shade during the day?"
      options={yesNo}
      required={true}
    />
    <Select
      name="homeowner"
      placeholder="Select an option"
      label="Do you own the property?"
      options={yesNo}
      required={true}
    />
    <Select
      name="zeroDown"
      placeholder="Select an option"
      label="Interested in $0 down solar financing?"
      options={yesNo}
      required={true}
    />
    <Input
      name="preferredConsultation"
      label="Preferred date & time for a free consultation"
      placeholder="e.g. Weekday mornings"
      type="text"
      required={true}
    />
    <Textarea name="notes" placeholder="Let us know any special requests or questions..." label="Additional Notes or Questions" rows={4} />

    {/* SMS/TCPA consent — a legal requirement for texting leads, and separate
        from cookie consent (which is disabled site-wide). Ports untouched. */}
    <Checkbox name="smsConsent" required={true}>
      By checking this box, I consent to receive transactional messages related
      to my account, orders, or services I have requested. These messages may
      include appointment reminders, order confirmations, and account
      notifications among others. Message frequency may vary. Message &amp; Data
      rates may apply. Reply STOP to opt out.
    </Checkbox>
    <Checkbox name="marketingConsent">
      By checking this box, I consent to receive marketing and promotional
      messages, including special offers, discounts, new product information,
      and other similar messages. Message frequency may vary. Message &amp; Data
      rates may apply. Reply STOP to opt out.
    </Checkbox>

    <Button
      type="submit"
      variant="primary"
      className="w-full mt-[var(--spacing-sm)] justify-center cursor-pointer"
    >
      Submit
    </Button>
  </FormWrapper>
</div>
