---
// src/components/Form/forms/RoofingForm.astro
/**
 * Roofing Inquiry Form — the primary conversion path on the roofing pages and
 * the Monmouth County landing pages.
 *
 * Ported from the legacy site field-for-field: the qualifying questions (roof
 * age, roof type, visible damage, $0-out-of-pocket interest, insurance claim)
 * are what make this different from the generic quote form, and they're what
 * the sales process runs on. Don't simplify them away.
 *
 * Falls back to the contact endpoint when PUBLIC_FORMSPREE_ROOFING_ID is unset,
 * matching the legacy fallback chain.
 */
import FormWrapper from "@/components/Form/FormWrapper";
import Input from "@/components/Form/inputs/Input";
import Select from "@/components/Form/inputs/Select";
import Textarea from "@/components/Form/inputs/Textarea";
import Checkbox from "@/components/Form/inputs/Checkbox";
import Button from "@/components/Button/Button";

interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const { title = "Roofing Inquiry", description, className = "" } = Astro.props;

const formId =
  import.meta.env.PUBLIC_FORMSPREE_ROOFING_ID ||
  import.meta.env.PUBLIC_FORMSPREE_CONTACT_ID ||
  import.meta.env.PUBLIC_FORMSPREE_ID;

const currentPageUrl = Astro.url.href;

const yesNo = [
  { value: "", label: "Select an option" },
  { value: "yes", label: "Yes" },
  { value: "no", label: "No" },
];

const roofTypes = [
  { value: "", label: "Select roof type" },
  { value: "shingle", label: "Shingle" },
  { value: "flat", label: "Flat" },
  { value: "metal", label: "Metal" },
  { value: "tile", label: "Tile" },
  { value: "other", label: "Other" },
];
---

<div class={className}>
  {title && <h2 class="h4 text-primary text-center">{title}</h2>}
  {description && <p class="text-center text-text-light">{description}</p>}

  <FormWrapper
    client:idle
    formspreeId={formId}
    useNativeFormSubmission={Boolean(formId)}
    successMessage="Thanks! We'll be in touch to schedule your free inspection."
    resetOnSuccess={true}
    className="w-full gap-0"
  >
    <input type="hidden" name="formName" value="Koi Roofing Inquiry" />
    <input type="hidden" name="pageUrl" value={currentPageUrl} />

    <div class="flex flex-col lg:flex-row lg:space-x-[var(--spacing-sm)]">
      <div class="w-full lg:w-1/2">
        <Input
          name="firstName"
          label="First Name"
          type="text"
          placeholder="First Name"
          required={true}
        />
      </div>
      <div class="w-full lg:w-1/2">
        <Input
          name="lastName"
          label="Last Name"
          type="text"
          placeholder="Last Name"
          required={true}
        />
      </div>
    </div>

    <Input
      name="address"
      label="Address (Include ZIP code)"
      type="text"
      placeholder="123 Main St, City, ST 12345"
      required={true}
    />
    <div class="flex flex-col lg:flex-row lg:space-x-[var(--spacing-sm)]">
      <div class="w-full lg:w-1/2">
        <Input
          name="phone"
          label="Phone Number"
          type="tel"
          placeholder="123-456-7890"
          required={true}
        />
      </div>
      <div class="w-full lg:w-1/2">
        <Input
          name="email"
          label="Email Address"
          type="email"
          placeholder="you@example.com"
          required={true}
        />
      </div>
    </div>


    <Input
      name="roofAge"
      placeholder="e.g. 10 years"
      label="Approximately How old is your roof? Take a guess if unsure"
      type="text"
    />
    <Select
      name="roofType"
      placeholder="Select roof type"
      label="What type of roof do you have?"
      options={roofTypes}
      required={true}
    />
    <Select
      name="visibleDamage"
      placeholder="Select an option"
      label="Visible damage, leaks, or missing shingles?"
      options={yesNo}
      required={true}
    />
    <Select
      name="zeroOutOfPocket"
      placeholder="Select an option"
      label="Interested in $0 out-of-pocket roof replacement?"
      options={yesNo}
      required={true}
    />
    <Select
      name="insuranceClaim"
      placeholder="Select an option"
      label="Is this related to an insurance claim?"
      options={yesNo}
      required={true}
    />
    <Input
      name="preferredInspection"
      label="Preferred date & time for a free inspection"
      placeholder="e.g. Weekday mornings"
      type="text"
      required={true}
    />
    <Textarea name="notes"
      placeholder="Let us know any special requests or questions..." label="Additional Notes or Questions" rows={4} />

    {/* SMS/TCPA consent — a legal requirement for texting leads, and separate
        from cookie consent (which is disabled site-wide). Ports untouched. */}
    <Checkbox name="smsConsent" required={true}>
      By checking this box, I consent to receive transactional messages related
      to my account, orders, or services I have requested. These messages may
      include appointment reminders, order confirmations, and account
      notifications among others. Message frequency may vary. Message &amp; Data
      rates may apply. Reply STOP to opt out.
    </Checkbox>
    <Checkbox name="marketingConsent">
      By checking this box, I consent to receive marketing and promotional
      messages, including special offers, discounts, new product information,
      and other similar messages. Message frequency may vary. Message &amp; Data
      rates may apply. Reply STOP to opt out.
    </Checkbox>

    <Button
      type="submit"
      variant="primary"
      className="w-full mt-[var(--spacing-sm)] justify-center cursor-pointer"
    >
      Submit
    </Button>
  </FormWrapper>
</div>
