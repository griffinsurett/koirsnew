---
// src/components/Banner.astro
/**
 * Banner — a centered CTA band: heading, description, buttons.
 *
 * Ports the legacy `banner` section variant (8 usages — the solar upsell band,
 * the closing CTA on service and landing pages). Carries no collection items,
 * so it's a plain component rather than a ContentRenderer variant.
 */
import type { SectionButton } from "@/components/ContentRenderer/ContentRenderer.types";
import SectionHeading from "@/components/SectionHeading.astro";
import SectionButtons from "@/components/ContentRenderer/SectionButtons.astro";

interface Props {
  title?: string;
  heading?: any;
  description?: string;
  className?: string;
  buttons?: SectionButton[];
  buttonsClassName?: string;
  id?: string;
}

const {
  title,
  heading,
  description,
  className = "",
  buttons = [],
  buttonsClassName = "",
  id,
} = Astro.props as Props;
---

<section
  id={id}
  class={`bg-bg text-center rounded-md my-[var(--spacing-lg)] py-[var(--spacing-2xl)] px-[var(--spacing-2xl)] flex flex-col justify-center items-center ${className}`}
>
  <div class="container mx-auto px-4 flex flex-col justify-center items-center">
    <SectionHeading heading={heading} title={title} description={description} />
    <SectionButtons buttons={buttons} class={`mt-[var(--spacing-md)] ${buttonsClassName}`} />
  </div>
</section>
