---
// src/components/MediaBand.astro
/**
 * Media Band — a full-width band over a background image or video, with
 * centered copy and CTAs.
 *
 * Ports the legacy `media1` / `media2` / `media4` section variants (13 usages:
 * the mission statement band, the closing bands on service pages). These carry
 * no collection items — they're copy + CTA — so this is a plain component
 * rather than a ContentRenderer variant, same as SpanishSection.
 *
 * Scroll animation: OFF for now (user request). A full-bleed band is awkward to
 * reveal with the trigger-based observer — it briefly exposed the page behind
 * it. The `animate` prop is kept so it can be switched back on, but nothing
 * passes it today.
 */
import type { SectionButton } from "@/components/ContentRenderer/ContentRenderer.types";
import BackgroundMedia from "@/components/BackgroundMedia.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SectionButtons from "@/components/ContentRenderer/SectionButtons.astro";

interface Props {
  title?: string;
  heading?: any;
  description?: string;
  className?: string;
  buttons?: SectionButton[];
  buttonsClassName?: string;
  id?: string;
  /** Background image (Astro asset or public path). */
  image?: any;
  /** object-position for the background image. Defaults to centre; pass
   *  "object-top" when the subject sits high in the frame (e.g. a group
   *  photo, where a centred crop cuts the faces off). */
  imageClass?: string;
  /** Background video (public path). */
  video?: string;
  /** Tint over the media so the copy stays legible. */
  overlayClass?: string;
  /** Fade the whole band (background media included) up on scroll. */
  animate?: boolean;
}

const {
  title,
  heading,
  description,
  className = "",
  buttons = [],
  buttonsClassName = "",
  image,
  video,
  imageClass = "",
  overlayClass = "bg-primary opacity-80",
  animate = false,
  id,
} = Astro.props as Props;


const backgroundMedia = (image || video)
  ? {
      ...(image ? { image: { src: image, imageClass } } : {}),
      ...(video ? { video: { src: video, preload: "metadata" } } : {}),
      overlayClass,
    }
  : null;

---

<section
  id={id}
  data-animate={animate ? "fade-in-up" : undefined}
  data-animate-once={animate ? "true" : undefined}
  class={`relative overflow-hidden py-16 md:py-24 ${className}`}
>
  {backgroundMedia && <BackgroundMedia backgroundMedia={backgroundMedia} />}

  <div class="relative z-10 container mx-auto px-4 text-center text-bg">
    <SectionHeading
      animate={false}
      heading={heading}
      title={title}
      description={description}
      tone="dark"
      headingClass="uppercase py-[var(--spacing-sm)]"
      descriptionClass="!text-lg md:!text-3xl !font-light italic"
    />

    {/* Optional body between the heading and the CTAs — for bands that carry
        structured content (a hours list, a stat row) rather than just a
        description string. Inherits the band's light `text-bg` colour. */}
    <slot />

    <SectionButtons buttons={buttons} class={`my-[var(--spacing-lg)] mt-[var(--spacing-md)] ${buttonsClassName}`} />
  </div>
</section>
