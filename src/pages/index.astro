---
// src/pages/index.astro
/**
 * Homepage — the one hand-composed page (everything else generates from
 * collections).
 *
 * ── STATUS: Phase 3.5 ─────────────────────────────────────────────────────
 * Wired with EXISTING starter variants only (GridVariant, ListVariant,
 * AccordionVariant, TestimonialVariant, ContactVariant, BlogVariant) so the
 * content-parity diff against the legacy site can run before any styling.
 * Deliberately unstyled — real variants and the brand skin land in the UI
 * phases.
 *
 * Band order below reproduces the legacy homepage exactly (KOI-REBUILD-PLAN
 * §3). Each band names its legacy variant so the mapping stays traceable when
 * the real variants get built.
 *
 * Four content types have no starter variant that can display them
 * (testimonial video, project before/after, gallery tiles, icons) — they're
 * asserted present via query here and get their real display in the UI phases.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Video from "@/components/Video/Video.astro";
import VideoSection from "@/layouts/VideoSection.astro";
import MainPageLayout from "@/layouts/MainPageLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import FrontPageHero from "@/layouts/FrontPageHero.astro";
import { siteData, businessData } from "@/content/siteData";
import { query, sortByOrder } from "@/utils/query";

import SectionButtons from "@/components/ContentRenderer/SectionButtons.astro";
import GoogleRating from "@/components/GoogleRating.astro";
---

<BaseLayout
  title={`${siteData.title} | Top-Quality Roofing & Solar Solutions for Your Home`}
  description="Full-service contractor serving NJ, PA & NYC. 20+ years of roofing & solar expertise—$0 down financing, 50-year warranties, stress-free installs. Serving Residential, Commercial, and Industrial."
>
  <main class="flex-1">
    {/* 1 — Hero (legacy: variant="primaryHero") */}
    <FrontPageHero
      eyebrow={siteData.title}
      title="Top-Quality Roofing & Solar Solutions for Your Home"
      description="Full-service contractor serving NJ, PA & NYC. 20+ years of roofing & solar expertise—$0 down financing, 50-year warranties, stress-free installs. Serving Residential, Commercial, and Industrial."
      primaryCTA={{ text: "Roofing", link: "/roofing" }}
      secondaryCTA={{ text: "Solar", link: "/solar" }}
    >
      {/* Google review badge under the hero CTAs — the legacy site's main
          trust signal, and the only place the review count appears above the
          fold. "50+" is the legacy's own copy (deliberately approximate). */}
      <GoogleRating slot="belowButtons" count="50+" tone="dark" class="mt-6" />
    </FrontPageHero>

    {/* Scrolling highlight strip under the hero (the johns-pro-roofing
        pattern). Queries `benefits` — the same collection the "Why Choose Us"
        band below renders — so the financing and warranty points lead the page
        as a glance-able strip before appearing in full. No separate marquee
        collection: this is a second view of existing content. */}
    <ContentRenderer
      query={query("benefits").orderBy(sortByOrder())}
      variant="MarqueeVariant"
    />

    {/* 2 — About: the Koi intro video on the left, copy on the right. */}
    <VideoSection video="/koirands-intro.mp4">
      <SectionHeading
        align="responsive"
        title={`About ${siteData.title}`}
        tagline='"Some start at the bottom we go to the top"'
        description={[
          `${siteData.title} is a proud ${businessData.ownership} company based in New Jersey, built on ${businessData.experience}. We combine expert craftsmanship with genuine care, treating every home like our own and every client like family.`,
          `Our mission is to change the way people experience contractors—making home upgrades smooth, honest, and even enjoyable. We specialize in residential roof replacements and solar energy systems, including flat roofs that few in New Jersey confidently handle or warranty. Whether it's storm damage, an aging roof, or high electric bills, we offer full-service solutions with ${businessData.financing}.`,
        ]}
        class="space-y-6"
        />
      <SectionButtons
        buttons={[
          { text: "Get Started", link: "/contact-us/", variant: "primary" },
          { text: "Learn More", link: "/about-us/", variant: "secondary" },
        ]}
        class="lg:justify-start mt-[var(--spacing-md)]"
      />

      {/* Who we serve — the legacy listSection2 band. Spans the full width
          beneath the copy AND the video, sharing the About band's light
          background rather than sitting in the copy column. */}
      <ContentRenderer
        slot="below"
        query={query("service-tiers").orderBy(sortByOrder())}
        variant="IconListVariant"
        centerOnMobile={false}
        columns={3}
        showHeadingSection={false}
        className="!py-0"
      />
    </VideoSection>



    <MainPageLayout />
  </main>
</BaseLayout>
