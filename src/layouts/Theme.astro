---
// src/layouts/Theme.astro
/**
 * Theme Component - Site Branding and Icons
 * 
 * Handles:
 * - Favicon configuration (multiple sizes and formats)
 * - Apple touch icons
 * - Theme color for mobile browsers
 * - PWA manifest (commented out)
 * 
 * All favicons point to Koi's branded favicon.png.
 * Can be customized to use different images per size.
 */

import "../styles/global.css";
// Animations intentionally disabled (AGENTS.md §7.9) — the legacy library
// is no longer used. Uncomment both lines to restore motion.
// import "../integrations/scroll-animations/styles/animations.css";
---

<!-- Favicons - multiple sizes for different contexts -->
<!-- Root-relative paths keep icons working on nested routes such as /blog/*
     and /service-areas/*. The prior relative URLs resolved inside each route. -->
<link rel="shortcut icon" type="image/png" href="/favicon.png" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />

<!-- PWA manifest (uncomment when ready) -->
<!-- <link rel="manifest" href="/site.webmanifest" /> -->

<!-- Mobile browser configuration -->
<meta name="mobile-web-app-capable" content="yes" />

<meta name="theme-color" content="#22324f" />
<!-- Theme color for mobile browsers -->
<!-- <meta name="apple-mobile-web-app-status-bar-style" content="var(--color-primary)" /> -->
<!-- <meta name="theme-color" content="var(--color-primary)" /> -->

