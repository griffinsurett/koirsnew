---
// src/layouts/SecondaryHero.astro
/**
 * Secondary Hero Layout
 *
 * Full-width Koi inner-page hero with optimized background image support.
 * The plain centered title banner used by collection index, legal and blog
 * pages, matching the legacy site's secondary hero.
 * The two-column service hero (copy + quote form) lives in ServiceHero.astro.
 *
 * Features:
 * - Responsive background images (mobile/tablet/desktop)
 * - Automatic LCP optimization with aboveTheFold
 * - Gradient overlay for text readability
 * - Optional metadata display (date, author, reading time)
 */

import { getAuthorName } from "@/layouts/collections/helpers/layoutHelpers";
import BackgroundMedia from "@/components/BackgroundMedia.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import defaultHeroImage from "@/assets/koi/roofingandsolarvid-poster.jpg";

export interface Props {
  title: string;
  image?: any; // Astro image asset or public path
  publishDate?: Date | string;
  author?: string | { collection: string; id: string };
  readingTime?: number;
  className?: string;
  minHeight?: string;
}

const {
  title,
  image,
  publishDate,
  author,
  readingTime,
  className = "",
  minHeight = "50vh",
} = Astro.props;

// Prepare optimized background media
const backgroundMedia = {
  image: {
    src: image || defaultHeroImage,
    imageClass: "brightness-75 object-cover object-center",
    aboveTheFold: true, // Automatic LCP optimization
  },
  // Legacy secondary hero: aerial Koi image beneath a navy readability tint.
  //
  // Strengthened from the legacy /65 to /80 for contrast. The tint is the only
  // thing guaranteeing legibility here, because the photo behind it is
  // arbitrary — any page can pass its own `image`, so a bright sky or a pale
  // roof can sit directly under the title.
  //
  // Worst case is a blown-out white pixel: brightness-75 takes it to #bfbfbf,
  // and navy at 80% composites that to ~#424c61. Against the cream title
  // (#f2f0ef) that is 7.6:1 — WCAG AAA, and AA for the smaller date/author
  // line at text-bg/90 (6.5:1). At the old /65 the same worst case was 5.5:1:
  // still AA, but with no headroom once a lighter photo is used.
  overlayClass: "bg-primary/80",
};
---

<section class={`relative ${className}`}>
  <div
    class="relative flex items-center justify-center overflow-hidden shadow-lg"
    style={`min-height: ${minHeight}`}
  >
    {/* Optimized background with overlay. Clipped here rather than on the
        flex parent — an overflow on the parent would disable position:sticky
        for the copy column. */}
    <div class="absolute inset-0 overflow-hidden">
      <BackgroundMedia backgroundMedia={backgroundMedia} />
    </div>

    {/* Hero content */}
    <div class="relative container mx-auto px-4 py-16 md:py-24 z-10">
      <div class="max-w-6xl mx-auto text-center text-bg">
        <SectionHeading
          headingTag="h1"
          tone="dark"
          align="center"
          heading={title}
          class="!mb-0 !max-w-none"
          headingClass="h1 !text-[clamp(3rem,5vw,7rem)] !tracking-wider !text-bg py-[var(--spacing-sm)]"
        />

        {/* Below the description, inside the copy column — the legacy service
            hero's `belowDescription` slot, used for the Google review badge. */}
        <slot name="belowDescription" />

        {/* Metadata row with icons */}
        {
          (publishDate || author || readingTime) && (
            <div class="flex flex-wrap justify-center gap-4 md:gap-6 text-sm md:text-base text-bg/90">
              {publishDate && (
                <time
                  datetime={new Date(publishDate).toISOString()}
                  class="flex items-center gap-2"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                  </svg>
                  {new Date(publishDate).toLocaleDateString()}
                </time>
              )}

              {author && (
                <span class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    />
                  </svg>
                  By {getAuthorName(author)}
                </span>
              )}

              {readingTime && (
                <span class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  {readingTime} min read
                </span>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>

  {/* Optional slot for additional content below hero */}
  <slot />
</section>

<style>
  /* Ensure text is readable on all backgrounds */
  h1,
  p {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }
</style>
