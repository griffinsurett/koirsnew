---
/**
 * Shared item layout for every generated service-area page: state, county,
 * and town. As in the legacy site, only the opening copy changes before the
 * page delegates to the same composition used by the homepage.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import FrontPageHero from "@/layouts/FrontPageHero.astro";
import MainPageLayout from "@/layouts/MainPageLayout.astro";
import VideoSection from "@/layouts/VideoSection.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SectionButtons from "@/components/ContentRenderer/SectionButtons.astro";
import JsonLd from "@/components/JsonLd.astro";
import { siteData, businessData } from "@/content/siteData";
import { ancestorsOf, buildAreaServedFor, loadAreaIndex } from "@/utils/schema/placeSchema";
import { BUSINESS_ID, BUSINESS_TYPE } from "@/utils/schema/businessSchema";
import type { CollectionLayoutProps } from "./types";

const { entry, Content, seoProps = {} } = Astro.props as CollectionLayoutProps;
const data = (entry?.data ?? {}) as Record<string, any>;
const place = data.title ?? "";
const tags: string[] = Array.isArray(data.tags) ? data.tags : [];
const areaServed = entry?.id ? await buildAreaServedFor(entry.id) : undefined;
const { byId } = await loadAreaIndex();
const areaNode = entry?.id ? byId.get(entry.id) : undefined;
const ancestors = areaNode ? ancestorsOf(areaNode, byId) : [];
const parent = ancestors[0];
const root = ancestors.at(-1);
const regionLabel = root?.abbr || root?.title;
const locationQualifier = [parent?.title, regionLabel]
  .filter((value, index, values) => value && values.indexOf(value) === index)
  .join(", ");
const locationContext = [place, parent?.title, regionLabel]
  .filter((value, index, values) => value && values.indexOf(value) === index)
  .join(", ");
const localBusinessSchema = areaServed?.length
  ? {
      "@context": "https://schema.org",
      "@type": BUSINESS_TYPE,
      "@id": BUSINESS_ID,
      name: siteData.legalName || siteData.title,
      url: siteData.url,
      areaServed,
    }
  : null;
const locationSeo = {
  ...seoProps,
  seo: {
    ...(seoProps as any).seo,
    // Same-named municipalities exist in different counties. Include the
    // hierarchy in search metadata while leaving the visible page copy clean.
    metaTitle: parent
      ? `${place} Roofing & Solar | ${locationQualifier}`
      : `${place} Roofing & Solar Services`,
    metaDescription: `Professional roofing and solar services in ${locationContext || place}. Koi Roofing and Solar offers inspections, installation, repairs, financing, and free estimates.`,
    keywords: [place, ...tags].filter(Boolean),
  },
};
---

<BaseLayout {...locationSeo}>
  <JsonLd schema={localBusinessSchema} />
  <main class="flex-1">
    <FrontPageHero
      eyebrow={siteData.title}
      title={`Top-Quality Roofing & Solar Solutions in ${place}`}
      description={`At ${siteData.title}, we specialize in bringing premium, reliable service right to your doorstep in ${place}. From $0-down financing to full-system installs, your home is in expert hands.`}
      primaryCTA={{ text: "Roofing", link: "/roofing" }}
      secondaryCTA={{ text: "Solar", link: "/solar" }}
    />

    <VideoSection video="/notlikekoi.mp4" reverse={true}>
      <SectionHeading
        align="responsive"
        title={`Serving ${place} & Surrounding Areas`}
        tagline='"Some start at the bottom—we take you to the top"'
        description={`At ${siteData.title}, we're proud to serve homeowners in ${place} and the surrounding communities. As a family-owned company with ${businessData.experience}, we bring expert craftsmanship, transparent pricing, and genuine care to every roof and solar installation. Whether you need a free inspection, emergency repair, a brand-new roof, or a turnkey solar energy system, our local team makes the process smooth and stress-free. We offer ${businessData.financing}, industry-leading warranties, and a commitment to treating your home like our own—because here in ${place}, your peace of mind is our top priority.`}
        class="space-y-6"
      />
      <SectionButtons
        buttons={[
          { text: "Get Started", link: "/contact-us/", variant: "primary" },
          { text: "Learn More", link: "/about-us/", variant: "secondary" },
        ]}
        class="lg:justify-start mt-[var(--spacing-md)]"
      />
    </VideoSection>

    {Content && (
      <div class="container mx-auto px-4 py-0">
        <Content />
      </div>
    )}

    <MainPageLayout />
  </main>
</BaseLayout>
