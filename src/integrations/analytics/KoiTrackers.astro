---
// src/integrations/analytics/KoiTrackers.astro
/**
 * The <head> half of Koi's tracker set. Rendered from IntHeadScripts.
 *
 * ── TRACKER PARITY IS NON-NEGOTIABLE (AGENTS.md) ──────────────────────────
 * Every id here is carried over verbatim from the legacy site. The `_2`
 * variants are NOT duplicates awaiting consolidation — both are live and hold
 * reporting history. Consolidating one would orphan any audience or conversion
 * built on it.
 *
 * All load DIRECTLY (no `type="text/plain" data-consent="…"`): the consent
 * script that would unblock a gated tag is disabled for Koi, so a gated tag
 * would simply never fire.
 *
 * ── ONE DELIBERATE ASYMMETRY ──────────────────────────────────────────────
 * PUBLIC_GA4_ID runs through Partytown (off the main thread); PUBLIC_GA4_ID_2
 * loads as a normal async script. That's how the legacy site had it, so the
 * split is reproduced rather than normalized. Partytown forwards dataLayer.push
 * (configured in IntBodyScripts) which is what makes the off-thread one work.
 *
 * The Meta Pixel <noscript> images and both GTM <noscript> iframes must be
 * inside <body> — they live in IntBodyScripts.
 */

const GA4 = import.meta.env.PUBLIC_GA4_ID;
const GA4_2 = import.meta.env.PUBLIC_GA4_ID_2;
const PIXEL = import.meta.env.PUBLIC_META_PIXEL_ID;
const PIXEL_2 = import.meta.env.PUBLIC_META_PIXEL_ID_2;
const CLARITY = import.meta.env.PUBLIC_CLARITY_ID;
const VERIFY = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const pixels = [PIXEL, PIXEL_2].filter(Boolean);
---

{/* Google Search Console verification */}
{VERIFY && <meta name="google-site-verification" content={VERIFY} />}

{/* GA4 #1 — via Partytown, off the main thread (legacy behavior) */}
{GA4 && (
  <>
    <script async type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${GA4}`}></script>
    <script
      type="text/partytown"
      set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${GA4}');
      `}
    />
  </>
)}

{/* GA4 #2 — normal main-thread load (legacy behavior) */}
{GA4_2 && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_2}`}></script>
    <script
      is:inline
      set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${GA4_2}');
      `}
    />
  </>
)}

{/* Microsoft Clarity */}
{CLARITY && (
  <script
    is:inline
    set:html={`
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "${CLARITY}");
    `}
  />
)}

{/* Meta Pixel — both ids share ONE fbq block with two init calls and a single
    PageView, matching the legacy implementation exactly. */}
{pixels.length > 0 && (
  <script
    is:inline
    set:html={`
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      ${pixels.map((id) => `fbq('init', '${id}');`).join('\n      ')}
      fbq('track', 'PageView');
    `}
  />
)}
